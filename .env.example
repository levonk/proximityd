# proximityd environment variables
# Copy this file to .env and fill in your values, or export these in your shell.

# Directory containing config.toml and presence.toml
# PROXIMITYD_CONFIG_DIR=~/.config/proximityd

# Discord webhook URL (overrides config file)
# PROXIMITYD_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Log level: ERROR, WARN, INFO, DEBUG, TRACE
# PROXIMITYD_LOG_LEVEL=INFO
