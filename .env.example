# btnotify environment variables
# Copy this file to .env and fill in your values, or export these in your shell.

# Directory containing config.toml and devices.toml
# BTNOTIFY_CONFIG_DIR=~/.config/btnotify

# Discord webhook URL (overrides config file)
# BTNOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Log level: ERROR, WARN, INFO, DEBUG, TRACE
# BTNOTIFY_LOG_LEVEL=INFO
